  "demonstration": {
    "reveals": [
      {
        "bind": "lead_resistance",
        "label": {
          "en": "Lead resistance in series with the measurement"
        },
        "quantity": "r",
        "visual": {
          "treatment": "none"
        },
        "teaching_point": {
          "en": "Two metres of AWG 24 is about 0.16 Ω. A two-wire measurement counts both leads, so a 100 Ω platinum RTD reads a third of an ohm high — nearly a degree of error on a sensor whose whole span is 0.385 Ω per degree, and it is exactly why four-wire sensing exists."
        }
      }
    ],
