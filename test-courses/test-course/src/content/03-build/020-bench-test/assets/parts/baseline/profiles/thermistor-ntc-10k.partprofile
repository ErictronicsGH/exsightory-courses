    "reveals": [
      {
        "bind": "self_heating_error",
        "label": {
          "en": "Self-heating measurement error",
          "fr": "Erreur de mesure due à l’auto-échauffement"
        },
        "enables_axis": "self_heating",
        "quantity": "t_j",
        "visual": {
          "treatment": "heat"
        },
        "teaching_point": {
          "en": "The current you measure it with warms it, so the sensor reads its own excitation. Halve the current and the error falls fourfold — which is the whole argument for a low sense current.",
          "fr": "Le courant qui sert à la mesurer la chauffe, si bien que le capteur lit sa propre excitation. Divisez le courant par deux et l’erreur est divisée par quatre — c’est tout l’argument en faveur d’un faible courant de mesure."
        }
      }
