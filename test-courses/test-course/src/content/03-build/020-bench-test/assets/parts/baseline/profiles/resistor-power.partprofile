      "probe",
      "substitute",
      "replace"
    ],
    "availability": {
      "en": "5 W wirewound in TO-220 is a stock item; the heatsink is the part people forget to order.",
      "fr": "Une bobinée de 5 W en TO-220 est un article courant ; le dissipateur est la pièce qu’on oublie de commander."
    }
  },
