  "damage": {
    "trigger": {
      "quantity": "p_ratio",
      "threshold": 1,
      "hold_s": 1
    },
    "mode": "short",
    "confidence": "typical",
    "note": {
      "en": "A punched-through junction usually fails short, which is far more dangerous downstream than an open."
    }
  },
  "demonstration": {
    "reveals": [
      {
        "bind": "reverse_leakage",
        "label": {
          "en": "Reverse leakage current"
        },
        "enables_axis": "leakage",
        "quantity": "i_r",
        "transform": {
          "type": "magnitude",
          "factor": 1000000,
          "badge": "×10⁶"
        },
        "visual": {
          "treatment": "flow_density",
          "direction": "reverse"
        },
        "context": {
          "typical_display": "≈ 2.5 nA at 25 °C — this profile’s saturation current",
          "comparison": "forward current in this circuit",
          "note": {
            "en": "Leakage roughly doubles every 10 °C. A datasheet quotes nearer 25 nA at 20 V, because most of a real diode’s reverse current creeps across the surface and no saturation-current model has it."
          }
        },
        "teaching_point": {
          "en": "Reverse current is real, not zero. Negligible in a rectifier; decisive in a sample-and-hold or a long-integration front end."
        }
      },
      {
        "bind": "vf_temp_drift",
        "label": {
          "en": "Forward voltage against temperature"
        },
        "enables_axis": "vf_tempco",
        "quantity": "v_f",
        "visual": {
          "treatment": "none"
        },
        "teaching_point": {
          "en": "−2 mV/°C is why a diode makes a usable thermometer and a poor voltage reference."
        }
      }
    ],
    "panes": [
      "operating",
      "ideality"
    ],
    "interactions": [
      "probe",
      "substitute",
      "replace"
    ]
  },
