    "t_r": {
      "value": 5e-08,
      "unit": "s",
      "terminal": "d",
      "band": "10_90",
      "conditions": {
        "v_ds_v": 30,
        "i_d_a": 5,
        "r_g_ohm": 10,
        "v_gs_v": 10,
        "t_j_c": 25
      },
      "source": {
        "note": "Rise time at the drain, class-representative for a standard-level TO-220 part driven from a ten-ohm gate resistor. The conditions matter more here than for almost any other number on this part: halve the gate resistor and the edge roughly halves with it, so a rise time quoted without its drive is not a specification."
      },
      "confidence": "typical",
      "note": {
        "en": "Ten to ninety per cent, which is how a datasheet quotes it. IBIS quotes its ramp twenty to eighty, and the two are different numbers for the same edge — which is why the band is stored beside the number rather than assumed by whatever reads it."
      }
    }
  },
