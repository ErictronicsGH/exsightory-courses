  "damage": {
    "trigger": {
      "quantity": "t_j",
      "threshold": 175,
      "hold_s": 0.5
    },
    "mode": "short",
    "confidence": "typical",
    "note": {
      "en": "An overheated MOSFET usually fails drain-to-source short, which puts the full supply across whatever it was switching."
    }
  },
  "demonstration": {
    "reveals": [
      {
        "bind": "rds_runaway",
        "label": {
          "en": "On-resistance against junction temperature"
        },
        "enables_axis": "rds_tempco",
        "quantity": "rds_on",
        "visual": {
          "treatment": "heat"
        },
        "teaching_point": {
          "en": "Current raises power, power raises temperature, temperature raises resistance, resistance raises power. This is the loop, and it is why real hardware runs away."
        }
      },
      {
        "bind": "gate_drive_mismatch",
        "label": {
          "en": "Gate drive against specified conditions"
        },
        "quantity": "v_gs",
        "visual": {
          "treatment": "hatch"
        },
        "teaching_point": {
          "en": "On-resistance is specified at 10 V on the gate. Drive it from 3.3 V logic and the stated figure does not apply — which is why so many student projects run hot."
        }
      }
    ],
