{
  "class": "diode",
  "label": {
    "en": "Diode",
    "fr": "Diode"
  },
  "designator": "D",
  "category": "semiconductors",
  "typical": {
    "source": {
      "document": "Vishay Semiconductors, document 81857 (1N4148)",
      "revision": "Rev. 1.6, 07-Nov-2024",
      "note": "Ptot = 440 mW, the class representative a small-signal glass diode (DO-35) is rated at. Absolute maximum only: a recommended figure is a profile's own choice of margin, and the class guessing one would print a rated power on a card that no datasheet gave."
    },
    "limits": {
      "absolute_max": {
        "p_w": 0.44
      },
      "recommended": {}
    }
  },
  "terminals": [
    {
      "id": "a",
      "label": {
        "en": "anode",
        "fr": "anode"
      },
      "role": "anode",
      "signal": "bidirectional"
    },
    {
      "id": "k",
      "label": {
        "en": "cathode",
        "fr": "cathode"
      },
      "role": "cathode",
      "signal": "bidirectional"
    }
  ],
  "variants": {
    "signal": {
      "symbol": "symbols/iec/diode.svg",
      "label": {
        "en": "Signal diode",
        "fr": "Diode de signal"
      }
    },
    "schottky": {
      "symbol": "symbols/iec/diode-schottky.svg",
      "label": {
        "en": "Schottky",
        "fr": "Schottky"
      }
    },
    "zener": {
      "symbol": "symbols/iec/diode-zener.svg",
      "label": {
        "en": "Zener",
        "fr": "Zener"
      },
      "default_reveals": [
        "breakdown_region"
      ]
    },
    "led": {
      "symbol": "symbols/iec/led.svg",
      "label": {
        "en": "LED",
        "fr": "LED"
      }
    }
  },
  "fast_model": {
    "equation": "shockley",
    "requires": [
      "is",
      "n"
    ],
    "optional": [
      "rs",
      "bv",
      "cjo",
      "tt",
      "alpha_vf",
      "r_th_ja_c_per_w"
    ],
    "outputs": [
      "i_f",
      "i_r",
      "v_f",
      "p"
    ]
  },
  "characteristic": {
    "x": "v_ak",
    "y": "i_a",
    "sweep": {
      "from": -60,
      "to": 1.2,
      "points": 400
    },
    "family": null,
    "default_scale": {
      "x": "linear",
      "y": "log"
    }
  },
  "regions": [
    {
      "id": "breakdown",
      "label": {
        "en": "Breakdown",
        "fr": "Claquage"
      },
      "tone": "edge",
      "when": [
        {
          "of": "v_ak + bv",
          "below": 0
        }
      ]
    },
    {
      "id": "forward",
      "label": {
        "en": "Forward",
        "fr": "Direct"
      },
      "tone": "on",
      "when": [
        {
          "of": "v_ak",
          "above": 0
        }
      ]
    },
    {
      "id": "reverse",
      "label": {
        "en": "Reverse",
        "fr": "Inverse"
      },
      "tone": "off",
      "when": []
    }
  ],
  "ideality_axes": {
    "leakage": {
      "requires": [
        "is"
      ],
      "default": false,
      "label": {
        "en": "Reverse leakage",
        "fr": "Fuite inverse"
      }
    },
    "vf_tempco": {
      "requires": [
        "alpha_vf"
      ],
      "default": false,
      "label": {
        "en": "Forward voltage drift",
        "fr": "Dérive de la tension directe"
      }
    },
    "junction_cap": {
      "requires": [
        "cjo"
      ],
      "default": false,
      "label": {
        "en": "Junction capacitance",
        "fr": "Capacité de jonction"
      }
    },
    "recovery": {
      "requires": [
        "tt"
      ],
      "default": false,
      "label": {
        "en": "Reverse recovery",
        "fr": "Recouvrement inverse"
      }
    }
  },
  "capabilities": {
    "reveals": [
      "reverse_leakage",
      "reverse_recovery",
      "vf_temp_drift",
      "breakdown_region",
      "overcurrent"
    ],
    "panes": [
      "operating",
      "ideality"
    ],
    "interactions": [
      "probe",
      "substitute",
      "replace"
    ]
  }
}
