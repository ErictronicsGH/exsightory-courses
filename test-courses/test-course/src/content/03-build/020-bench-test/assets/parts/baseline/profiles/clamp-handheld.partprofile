      "source": {
        "note": "± 1.5 % of reading, representative of a Hall-effect clamp. It is what makes this instrument imperfect: a clamp changes nothing about the circuit, so the honest statement of its non-ideality is what its jaw can resolve rather than what it costs the branch."
      },
      "confidence": "typical"
    },
    "accuracy_i_counts": {
      "value": 5,
      "dimensionless": true,
      "source": {
        "note": "± 5 counts of the last displayed digit, which is the fixed half of every instrument's accuracy and the half that dominates at the bottom of a range."
      },
      "confidence": "typical"
    },
    "resolution_a": {
      "value": 0.01,
      "unit": "A",
      "conditions": {
        "note": "the last displayed digit, 100 A range"
      },
      "source": {
        "note": "10 mA — the display's least significant digit on a 100 A jaw. The reading is quantised to it, because that is what a display does."
      },
      "confidence": "typical"
    },
    "i_floor_a": {
      "value": 0.05,
      "unit": "A",
      "conditions": {
        "note": "DC, jaw closed"
      },
      "source": {
        "note": "50 mA — below this the Hall sensor's own offset and the earth's field are larger than the current, and the instrument has nothing to show. The second thing that makes this clamp imperfect, and the one that decides whether it is the right instrument for a branch at all."
      },
      "confidence": "typical"
    },
    "digits": {
      "value": 3.5,
      "dimensionless": true,
