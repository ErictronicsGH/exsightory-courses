    "mode": "open",
    "confidence": "typical",
    "note": {
      "en": "Thick-film resistors usually fail open. A fusible type is designed to.",
      "fr": "Les résistances à couche épaisse s’ouvrent en général. Un modèle fusible est conçu pour cela."
    }
  },
  "demonstration": {
    "reveals": [
      {
        "bind": "overpower",
        "label": {
          "en": "Power dissipation against rating",
          "fr": "Puissance dissipée par rapport à la valeur nominale"
        },
        "quantity": "p",
        "visual": {
          "treatment": "heat"
        },
        "teaching_point": {
          "en": "A resistor at 40 % of rating runs warm and lasts; at 120 % it runs hot and does not. The rating is a thermal statement, not an electrical one.",
          "fr": "Une résistance à 40 % de sa valeur nominale tiédit et dure ; à 120 % elle chauffe fort et ne dure pas. La valeur nominale est un énoncé thermique, pas électrique."
        }
      },
      {
        "bind": "tempco_drift",
        "label": {
          "en": "Resistance drift with temperature",
          "fr": "Dérive de la résistance avec la température"
        },
        "enables_axis": "tempco",
        "quantity": "r",
        "visual": {
          "treatment": "none"
        },
        "teaching_point": {
          "en": "100 ppm/°C is 1 % over a 100 °C rise — invisible in a divider and decisive in a precision reference.",
          "fr": "100 ppm/°C, c’est 1 % pour une élévation de 100 °C — invisible dans un diviseur, décisif dans une référence de précision."
        }
      },
      {
        "bind": "thermal_settling",
        "label": {
          "en": "The climb to failure, slowed",
          "fr": "La montée vers la défaillance, ralentie"
        },
        "quantity": "t_j",
        "transform": {
          "type": "time",
          "factor": 10,
          "badge": "×10 slower"
        },
        "visual": {
          "treatment": "none"
        },
        "context": {
          "typical_display": "one second of the part’s own time per ten on the transport",
          "comparison": "the hold time this profile declares before it fails",
          "note": {
            "en": "The thermal mass is unchanged. Only the clock the room reads it against is stretched.",
            "fr": "La masse thermique est inchangée. Seule l’horloge à laquelle la salle la rapporte est étirée."
          }
        },
        "teaching_point": {
          "en": "A part that fails three seconds after the rating is crossed fails while somebody is still saying the sentence. Stretched, the room watches the temperature climb and can say where it stops before it does not.",
          "fr": "Un composant qui lâche trois secondes après le dépassement de sa valeur nominale lâche pendant qu’on est encore en train de finir sa phrase. Au ralenti, la salle voit la température monter et peut dire où elle devrait s’arrêter avant de constater qu’elle ne s’arrête pas."
        }
      }
    ],
    "panes": [
      "operating",
      "ideality"
    ],
    "interactions": [
      "probe",
      "substitute",
      "replace"
    ],
    "availability": {
      "en": "E24 values in 1 % thick film are stocked everywhere; E96 usually needs an order.",
      "fr": "Les valeurs E24 en couche épaisse 1 % se trouvent partout ; les E96 demandent en général une commande."
    }
  },
