{
  "class": "mosfet",
  "label": {
    "en": "MOSFET",
    "fr": "MOSFET"
  },
  "designator": "Q",
  "category": "semiconductors",
  "terminals": [
    {
      "id": "d",
      "label": {
        "en": "drain",
        "fr": "drain"
      },
      "role": "drain",
      "signal": "bidirectional"
    },
    {
      "id": "g",
      "label": {
        "en": "gate",
        "fr": "grille"
      },
      "role": "gate",
      "signal": "input"
    },
    {
      "id": "s",
      "label": {
        "en": "source",
        "fr": "source"
      },
      "role": "source",
      "signal": "bidirectional"
    }
  ],
  "variants": {
    "nmos": {
      "symbol": "symbols/iec/mosfet-n.svg",
      "label": {
        "en": "N-channel",
        "fr": "Canal N"
      }
    },
    "pmos": {
      "symbol": "symbols/iec/mosfet-p.svg",
      "label": {
        "en": "P-channel",
        "fr": "Canal P"
      }
    }
  },
  "fast_model": {
    "equation": "mosfet-square-law",
    "requires": [
      "vth",
      "kp"
    ],
    "optional": [
      "rds_on",
      "alpha_rds",
      "cgs",
      "cgd",
      "r_th_ja_c_per_w"
    ],
    "outputs": [
      "i_d",
      "v_ds",
      "v_gs",
      "p"
    ]
  },
  "characteristic": {
    "x": "v_ds",
    "y": "i_d",
    "sweep": {
      "from": 0,
      "to": 12,
      "points": 240
    },
    "family": {
      "parameter": "v_gs",
      "values": [
        2.5,
        3.5,
        4.5,
        6,
        10
      ]
    },
    "default_scale": {
      "x": "linear",
      "y": "linear"
    }
  },
  "transfer": {
    "x": "v_gs",
    "y": "i_d",
    "sweep": {
      "from": 0,
      "to": 10,
      "points": 240
    },
    "default_scale": {
      "x": "linear",
      "y": "linear"
    }
  },
  "regions": [
    {
      "id": "cutoff",
      "label": {
        "en": "Cutoff",
        "fr": "Blocage"
      },
      "tone": "off",
      "when": [
        {
          "of": "v_gs - vth",
          "below": 0
        }
      ]
    },
    {
      "id": "triode",
      "label": {
        "en": "Triode",
        "fr": "Ohmique (triode)"
      },
      "tone": "on",
      "when": [
        {
          "of": "v_ds - (v_gs - vth)",
          "below": 0
        }
      ]
    },
    {
      "id": "saturation",
      "label": {
        "en": "Saturation",
        "fr": "Saturation"
      },
      "tone": "edge",
      "when": []
    }
  ],
  "ideality_axes": {
    "rds_tempco": {
      "requires": [
        "alpha_rds"
      ],
      "default": false,
      "label": {
        "en": "On-resistance versus temperature",
        "fr": "Résistance à l’état passant en fonction de la température"
      }
    },
    "self_heating": {
      "requires": [
        "r_th_ja_c_per_w"
      ],
      "default": false,
      "label": {
        "en": "Self-heating",
        "fr": "Auto-échauffement"
      }
    },
    "gate_charge": {
      "requires": [
        "cgs",
        "cgd"
      ],
      "default": false,
      "label": {
        "en": "Gate capacitance",
        "fr": "Capacité de grille"
      }
    }
  },
  "capabilities": {
    "reveals": [
      "rds_runaway",
      "gate_drive_mismatch",
      "overpower"
    ],
    "panes": [
      "operating",
      "ideality"
    ],
    "interactions": [
      "probe",
      "substitute",
      "replace"
    ]
  }
}
