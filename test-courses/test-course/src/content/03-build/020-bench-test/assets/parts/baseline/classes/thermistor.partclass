{
  "class": "thermistor",
  "label": "Thermistor",
  "designator": "RT",
  "category": "sensors",
  "terminals": [
    {
      "id": "a",
      "label": "terminal A",
      "role": "terminal",
      "signal": "bidirectional"
    },
    {
      "id": "b",
      "label": "terminal B",
      "role": "terminal",
      "signal": "bidirectional"
    }
  ],
  "variants": {
    "ntc": {
      "symbol": "symbols/iec/thermistor.svg",
      "label": "NTC",
      "alternates": {
        "ansi": "symbols/ansi/thermistor.svg"
      }
    }
  },
  "fast_model": {
    "equation": "expression",
    "expression": "v / (r0 * exp(beta * (1 / (t_j + 273.15) - 1 / 298.15)))",
    "value_parameter": "r0",
    "requires": [
      "r0",
      "beta"
    ],
    "optional": [
      "r_th_ja_c_per_w"
    ],
    "outputs": [
      "v",
      "i",
      "r",
      "p"
    ]
  },
  "ideality_axes": {
    "self_heating": {
      "requires": [
        "r_th_ja_c_per_w"
      ],
      "default": false,
      "label": "Self-heating error"
    }
  },
  "capabilities": {
    "reveals": [
      "self_heating_error"
    ],
    "panes": [
      "operating",
      "specifying",
      "provenance",
      "ideality",
      "sensitivity"
    ],
    "interactions": [
      "probe",
      "inspect",
      "scrub",
      "substitute",
      "replace"
    ]
  }
}
