{
  "class": "capacitor",
  "label": {
    "en": "Capacitor",
    "fr": "Condensateur"
  },
  "designator": "C",
  "category": "passives",
  "terminals": [
    {
      "id": "a",
      "label": {
        "en": "terminal A",
        "fr": "borne A"
      },
      "role": "terminal",
      "signal": "bidirectional"
    },
    {
      "id": "b",
      "label": {
        "en": "terminal B",
        "fr": "borne B"
      },
      "role": "terminal",
      "signal": "bidirectional"
    }
  ],
  "variants": {
    "ceramic": {
      "symbol": "symbols/iec/capacitor.svg",
      "label": {
        "en": "Ceramic",
        "fr": "Céramique"
      }
    },
    "electrolytic": {
      "symbol": "symbols/iec/capacitor-polarised.svg",
      "label": {
        "en": "Electrolytic",
        "fr": "Électrolytique"
      }
    },
    "film": {
      "symbol": "symbols/iec/capacitor.svg",
      "label": {
        "en": "Film",
        "fr": "Film"
      }
    }
  },
  "fast_model": {
    "equation": "capacitive",
    "value_parameter": "c",
    "requires": [
      "c"
    ],
    "optional": [
      "esr",
      "alpha",
      "r_th_ja_c_per_w"
    ],
    "outputs": [
      "v",
      "i",
      "c_effective"
    ]
  },
  "ideality_axes": {
    "bias_derating": {
      "requires": [
        "curve:c-vs-vdc"
      ],
      "default": false,
      "label": {
        "en": "Capacitance versus DC bias",
        "fr": "Capacité en fonction de la polarisation continue"
      }
    },
    "esr": {
      "requires": [
        "esr"
      ],
      "default": false,
      "label": {
        "en": "Series resistance",
        "fr": "Résistance série"
      }
    },
    "tempco": {
      "requires": [
        "alpha"
      ],
      "default": false,
      "label": {
        "en": "Temperature coefficient",
        "fr": "Coefficient de température"
      }
    },
    "tolerance": {
      "requires": [
        "c_min",
        "c_max"
      ],
      "default": false,
      "label": {
        "en": "Tolerance spread",
        "fr": "Dispersion dans la tolérance"
      }
    }
  },
  "capabilities": {
    "adjust": {
      "parameter": "c",
      "legend": {
        "en": "Capacitance",
        "fr": "Capacité"
      },
      "from": 1e-12,
      "to": {
        "parameter": "c_dial_max"
      },
      "series": "E12"
    },
    "reveals": [
      "bias_collapse",
      "ripple_heating"
    ],
    "panes": [
      "operating",
      "ideality"
    ],
    "interactions": [
      "probe",
      "substitute",
      "replace"
    ]
  }
}
