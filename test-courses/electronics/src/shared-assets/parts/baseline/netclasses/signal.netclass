{
  "netclass": "signal",
  "label": "Signal",
  "permitted_rise_c": 10,
  "placement": "external",
  "copper_oz": 1,
  "note": {
    "en": "The default for anything that carries information rather than power. Ten degrees is the rise almost every board is designed to, and one ounce is what a two-layer board is etched on unless somebody asked for otherwise — so this is the class a net belongs to when nobody has thought about it yet, and it is deliberately the one that makes a milliamp look comfortable and an amp look wrong."
  }
}
