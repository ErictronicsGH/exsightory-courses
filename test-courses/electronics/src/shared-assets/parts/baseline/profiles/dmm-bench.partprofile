        "label": {
          "en": "Input impedance loading",
          "fr": "Charge due à l’impédance d’entrée"
        },
        "enables_axis": "input_loading",
        "quantity": "v",
        "visual": {
          "treatment": "none"
        },
        "teaching_point": {
          "en": "10 GΩ across the same 1 MΩ divider changes the reading by 0.01 %. Swap the meters and the error appears and vanishes while the circuit stays put.",
          "fr": "10 GΩ en parallèle sur le même diviseur de 1 MΩ modifient la mesure de 0.01 %. Échangez les multimètres : l’erreur apparaît puis disparaît sans que le circuit bouge."
        }
      }
    ],
