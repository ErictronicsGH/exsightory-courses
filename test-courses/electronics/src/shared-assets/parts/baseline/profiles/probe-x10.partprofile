      "value": 90000000,
      "unit": "Ω",
      "conditions": {
        "note": "DC, at the tip"
      },
      "source": {
        "note": "Nine parts of series resistance to one part of instrument input, which is what makes a passive divider a ×10 — 9 MΩ for the 1 MΩ oscilloscope this convention was named for, and 90 MΩ for the 10 MΩ handheld it is being used with here."
      },
      "confidence": "typical"
    },
    "r_in_specified": {
      "value": 10000000,
      "unit": "Ω",
      "conditions": {
        "note": "the instrument this probe is built for"
      },
      "source": {
        "note": "A passive probe divides against the instrument's own input impedance and cannot divide without one. Stating which input it was built for is what makes the ×10 on its body a checkable claim rather than a label."
      },
      "confidence": "typical"
    },
    "attenuation": {
      "value": 10,
      "dimensionless": true,
      "source": {
        "note": "What the nameplate says, and what the panel multiplies the instrument's reading by."
      },
      "confidence": "typical"
    }
  },
  "limits": {
    "absolute_max": {
      "v_in_v": 300
    },
