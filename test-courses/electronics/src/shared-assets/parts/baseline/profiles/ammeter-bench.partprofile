      "source": {
        "note": "The shunt the meter starts on. A tenth of an ohm at an amp is a hundred millivolts out of the branch, which is the number a room is meant to notice."
      },
      "confidence": "typical"
    },
    "r_burden_max": {
      "value": 10,
      "unit": "Ω",
      "conditions": {
        "range": "10 mA"
      },
      "source": {
        "note": "The largest shunt this instrument can switch in — the low current range, where sensitivity is bought with burden voltage. It is the end of the dial and it is a specification of the instrument rather than a rating: nothing here is damaged by a large shunt, which is why it is stated as a parameter and not in \"limits\"."
      },
      "confidence": "typical"
    },
    "digits": {
