{
  "profile": "rtd-pt100",
  "class": "resistor",
  "variant": "fixed",
  "display_name": "Platinum RTD, Pt100",
  "provenance": {
    "typical": true
  },
  "parameters": {
    "r": {
      "value": 100,
      "unit": "Ω",
      "conditions": {
        "t_a_c": 0
      },
      "source": {
        "note": "A Pt100 is defined by this number: one hundred ohms at the ice point. IEC 60751."
      },
      "confidence": "typical"
    },
    "alpha": {
      "value": 0.00385,
      "unit": "1/°C",
      "conditions": {
        "t_a_c": 0
      },
      "source": {
        "note": "IEC 60751's European curve — 0.385 Ω per °C over the first hundred degrees, which is what makes a tenth of an ohm a quarter of a degree."
      },
      "confidence": "typical"
    },
    "r_th_ja_c_per_w": {
      "value": 200,
      "unit": "°C/W",
      "conditions": {
        "mount": "thin-film element in a sheath, still air"
      },
      "source": {
        "note": "A self-heating coefficient of about 5 mW/°C, stated the way this bench states thermal resistance. It is why an RTD is excited with a milliamp and not ten."
      },
      "confidence": "typical"
    }
  },
  "limits": {
    "absolute_max": {
      "p_w": 0.05,
      "i_a": 0.02,
      "t_j_c": 250
    },
    "recommended": {
      "p_w": 0.0005,
      "i_a": 0.001
    }
  },
  "physical": {
    "thermal": {
      "r_th_ja_c_per_w": {
        "value": 200,
        "unit": "°C/W",
        "conditions": {
          "mount": "thin-film element in a sheath, still air"
        },
        "source": {
          "note": "The same 5 mW/°C, as the derive layer reads it."
        },
        "confidence": "typical"
      },
      "c_th_j_per_c": 0.05
    }
  },
  "demonstration": {
    "reveals": [
      {
        "bind": "tempco_drift",
        "label": {
          "en": "What the sensor is actually reporting"
        },
        "enables_axis": "tempco",
        "quantity": "r",
        "visual": {
          "treatment": "none"
        },
        "context": {
          "typical_display": "0.385 Ω per °C",
          "comparison": "the resistance of the leads carrying the measurement"
        },
        "teaching_point": {
          "en": "The whole instrument is this: 0.385 Ω per °C. A tenth of an ohm is a quarter of a degree, which is why two metres of lead in series with the sensor is not a rounding error — it is the reading."
        }
      },
      {
        "bind": "overpower",
        "label": {
          "en": "Self-heating from the excitation current"
        },
        "quantity": "p",
        "visual": {
          "treatment": "heat"
        },
        "teaching_point": {
          "en": "A thermometer that heats itself measures itself. At 5 mW/°C, a milliamp through 100 Ω is a fifth of a milliwatt and costs a twentieth of a degree; ten milliamps costs two degrees, and the sensor is now the hottest thing in the bath."
        }
      }
    ],
    "panes": [
      "operating",
      "specifying",
      "provenance",
      "ideality",
      "sensitivity"
    ],
    "interactions": [
      "probe",
      "inspect",
      "scrub",
      "substitute",
      "replace"
    ],
    "availability": {
      "en": "Class A and class B elements are stocked everywhere; the class is a tolerance on the same curve."
    }
  },
  "pcb": {
    "package": {
      "code": "PT100-A",
      "mount": "none",
      "hand_solderable": true
    }
  }
