      "source": {
        "note": "A Pt100 is defined by this number: one hundred ohms at the ice point. IEC 60751."
      },
      "confidence": "typical"
    },
    "alpha": {
      "value": 0.00385,
      "unit": "1/°C",
      "conditions": {
        "t_a_c": 0
      },
      "source": {
        "document": "IEC 60751, Industrial platinum resistance thermometers and platinum temperature sensors",
        "note": "IEC 60751 defines the European curve by this number: 0.385 Ω per °C over the first hundred degrees, which is what makes a tenth of an ohm a quarter of a degree. A definition, so stated, and shown to four figures."
      },
      "confidence": "stated"
    },
    "r_th_ja_c_per_w": {
      "value": 200,
      "unit": "°C/W",
      "conditions": {
        "mount": "thin-film element in a sheath, still air"
      },
      "source": {
        "note": "A self-heating coefficient of about 5 mW/°C, stated the way this bench states thermal resistance. It is why an RTD is excited with a milliamp and not ten."
      },
      "confidence": "typical"
    }
  },
  "limits": {
    "absolute_max": {
      "p_w": 0.05,
      "i_a": 0.02,
      "t_j_c": 250
