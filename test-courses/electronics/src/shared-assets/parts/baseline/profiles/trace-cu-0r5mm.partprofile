      "source": {
        "note": "Annealed copper, the standard textbook value at 20 °C. Electrodeposited foil is within a couple of per cent of it."
      },
      "confidence": "typical"
    },
    "width_mm": {
      "value": 0.5,
      "unit": "mm",
      "conditions": {
        "note": "as drawn"
      },
      "source": {
        "note": "A common default track width in every layout tool, and the width somebody uses when they have not yet asked what the track carries."
      },
      "confidence": "typical"
    },
    "copper_oz": {
      "value": 1,
      "unit": "oz/ft²",
      "conditions": {
        "note": "outer layer, as finished"
      },
      "source": {
        "note": "One ounce is the standard outer-layer foil on a two-layer board. It is a weight per area being used as a thickness — 1.378 mils of copper."
      },
      "confidence": "typical"
    },
    "alpha_per_c": {
      "value": 0.00393,
      "unit": "1/°C",
      "conditions": {
        "t_c": 20
      },
      "source": {
        "note": "Copper, the standard textbook value."
      },
      "confidence": "typical"
    },
    "i_rating_a": {
      "value": 1.3,
      "unit": "A",
      "conditions": {
        "note": "external layer, 10 °C rise"
      },
      "source": {
        "note": "What IPC-2221's own curve gives for this cross-section at a 10 °C rise on an outer layer. Stated here so the part carries its rating like every other part; NetClass Mode derives the same number from the net rather than reading it, which is the point of the mode."
      },
      "confidence": "typical"
    }
