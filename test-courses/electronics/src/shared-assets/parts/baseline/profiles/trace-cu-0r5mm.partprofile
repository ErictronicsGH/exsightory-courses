  "damage": {
    "trigger": {
      "quantity": "i_ratio",
      "threshold": 2.5,
      "hold_s": 15
    },
    "mode": "open",
    "confidence": "typical",
    "note": {
      "en": "A track that cannot lose its heat lifts off the laminate before it melts. The failure is usually the bond, not the copper."
    }
  },
  "demonstration": {
    "reveals": [
      {
        "bind": "ir_drop",
        "label": {
          "en": "The drop along the track itself"
        },
        "quantity": "v",
        "visual": {
          "treatment": "none"
        },
        "teaching_point": {
          "en": "A 0.5 mm track in 1 oz copper is about 25 mΩ for every 100 mm of it. That is nothing at a milliamp and it is a tenth of a volt at four amps — which is why a rail is drawn wide and a signal is not, and why the regulator's sense point matters."
        }
      }
    ],
