  "parameters": {
    "is": {
      "value": 2.5e-8,
      "unit": "A",
      "conditions": {
        "t_a_c": 25,
        "v_r_v": 20
      },
      "source": {
        "document": "Vishay Semiconductors, document 81857",
        "revision": "Rev. 1.6, 07-Nov-2024",
        "table": "Electrical characteristics"
      },
      "confidence": "derived",
      "derivation": "IS taken from the reverse point, where the Shockley current saturates at −IS; N then solved from the forward point. Points: VF ≤ 1 V at IF = 10 mA; IR ≤ 25 nA at VR = 20 V. IS = 2.500e-8 A, N = 3.017, at Vt = 25.693 mV.",
      "note": {
        "en": "IS is a reverse-current measurement, and a real diode's reverse current is mostly surface and generation leakage that the Shockley equation has no term for. This IS is therefore an upper bound on the junction's true saturation current, not an estimate of it."
      }
    },
    "n": {
      "value": 3.017,
      "dimensionless": true,
      "source": {
        "document": "Vishay Semiconductors, document 81857",
        "revision": "Rev. 1.6, 07-Nov-2024",
        "table": "Electrical characteristics"
      },
      "confidence": "derived",
      "derivation": "IS taken from the reverse point, where the Shockley current saturates at −IS; N then solved from the forward point. Points: VF ≤ 1 V at IF = 10 mA; IR ≤ 25 nA at VR = 20 V. IS = 2.500e-8 A, N = 3.017, at Vt = 25.693 mV.",
      "note": {
        "en": "N = 3.017 is outside the 1–2 that silicon allows, so this pair is a bounding envelope rather than a physical model. It reproduces the points it was fitted to and it will read high on forward voltage everywhere else — which for a datasheet's guaranteed maxima is the truthful direction to be wrong in."
      }
    },
    "bv": {
      "min": 100,
      "unit": "V",
      "conditions": {
        "i_r_a": 0.0001,
        "t_a_c": 25,
        "note": "tp/T = 0.01, tp = 0.3 ms"
      },
      "source": {
        "document": "Vishay Semiconductors, document 81857",
        "revision": "Rev. 1.6, 07-Nov-2024",
        "table": "Electrical characteristics",
        "note": "V(BR) ≥ 100 V. A guaranteed minimum, which is the breakdown a worst-case part has."
      },
      "confidence": "stated"
    },
    "cjo": {
