  "damage": {
    "trigger": {
      "quantity": "p_ratio",
      "threshold": 1,
      "hold_s": 1
    },
    "mode": "short",
    "confidence": "typical",
    "note": {
      "en": "A punched-through junction usually fails short, which is far more dangerous downstream than an open. The trigger is real on this profile for the first time: Ptot = 440 mW is stated, so \"p_ratio\" has a rating to be a ratio of.",
      "fr": "Une jonction perforée se met en général en court-circuit, ce qui est bien plus dangereux en aval qu’un circuit ouvert. Pour la première fois, le déclencheur est réel sur ce profil : Ptot = 440 mW est indiqué, si bien que « p_ratio » a une valeur nominale à laquelle se rapporter."
    }
  },
  "demonstration": {
    "reveals": [
      {
        "bind": "reverse_leakage",
        "label": {
          "en": "Reverse leakage current",
          "fr": "Courant de fuite inverse"
        },
        "enables_axis": "leakage",
        "quantity": "i_r",
        "transform": {
          "type": "magnitude",
          "factor": 1000000,
          "badge": "×10⁶"
        },
        "visual": {
          "treatment": "flow_density",
          "direction": "reverse"
        },
        "context": {
          "typical_display": "≤ 25 nA at 20 V and 25 °C — the datasheet’s stated maximum",
          "comparison": "forward current in this circuit",
          "note": {
            "en": "Leakage roughly doubles every 10 °C: the same sheet states ≤ 50 µA at 20 V once the junction reaches 150 °C, two thousand times the figure at room temperature.",
            "fr": "La fuite double à peu près tous les 10 °C : la même fiche indique ≤ 50 µA sous 20 V une fois la jonction à 150 °C, deux mille fois la valeur à température ambiante."
          }
        },
        "teaching_point": {
          "en": "Reverse current is real, not zero. Negligible in a rectifier; decisive in a sample-and-hold or a long-integration front end.",
          "fr": "Le courant inverse est réel, pas nul. Négligeable dans un redresseur ; décisif dans un échantillonneur-bloqueur ou un étage d’entrée à longue intégration."
        }
      },
      {
        "bind": "vf_temp_drift",
        "label": {
          "en": "Forward voltage against temperature",
          "fr": "Tension directe en fonction de la température"
        },
        "enables_axis": "vf_tempco",
        "quantity": "v_f",
        "visual": {
          "treatment": "none"
        },
        "teaching_point": {
          "en": "−2 mV/°C is why a diode makes a usable thermometer and a poor voltage reference.",
          "fr": "−2 mV/°C : voilà pourquoi une diode fait un thermomètre utilisable et une piètre référence de tension."
        }
      },
      {
        "bind": "breakdown_region",
        "label": {
          "en": "Reverse breakdown",
          "fr": "Claquage inverse"
        },
        "quantity": "i_r",
        "visual": {
          "treatment": "outline",
          "direction": "reverse"
        },
        "context": {
          "typical_display": "V(BR) ≥ 100 V at IR = 100 µA",
          "comparison": "the 75 V the part is rated to stand off continuously"
        },
        "teaching_point": {
          "en": "The rating and the breakdown are different numbers, and the gap between them is the manufacturer’s margin rather than yours.",
          "fr": "La valeur nominale et la tension de claquage sont deux nombres différents, et l’écart entre elles est la marge du fabricant, pas la vôtre."
        }
      }
    ],
    "panes": [
