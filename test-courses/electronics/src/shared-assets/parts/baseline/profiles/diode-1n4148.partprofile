  "damage": {
    "trigger": {
      "quantity": "p_ratio",
      "threshold": 1,
      "hold_s": 1
    },
    "mode": "short",
    "confidence": "typical",
    "note": {
      "en": "A punched-through junction usually fails short, which is far more dangerous downstream than an open. The trigger is real on this profile for the first time: Ptot = 440 mW is stated, so \"p_ratio\" has a rating to be a ratio of."
    }
  },
  "demonstration": {
    "reveals": [
      {
        "bind": "reverse_leakage",
        "label": {
          "en": "Reverse leakage current"
        },
        "enables_axis": "leakage",
        "quantity": "i_r",
        "transform": {
          "type": "magnitude",
          "factor": 1000000,
          "badge": "×10⁶"
        },
        "visual": {
          "treatment": "flow_density",
          "direction": "reverse"
        },
        "context": {
          "typical_display": "≤ 25 nA at 20 V and 25 °C — the datasheet’s stated maximum",
          "comparison": "forward current in this circuit",
          "note": {
            "en": "Leakage roughly doubles every 10 °C: the same sheet states ≤ 50 µA at 20 V once the junction reaches 150 °C, two thousand times the figure at room temperature."
          }
        },
        "teaching_point": {
          "en": "Reverse current is real, not zero. Negligible in a rectifier; decisive in a sample-and-hold or a long-integration front end."
        }
      },
      {
        "bind": "vf_temp_drift",
        "label": {
          "en": "Forward voltage against temperature"
        },
        "enables_axis": "vf_tempco",
        "quantity": "v_f",
        "visual": {
          "treatment": "none"
        },
        "teaching_point": {
          "en": "−2 mV/°C is why a diode makes a usable thermometer and a poor voltage reference."
        }
      },
      {
        "bind": "breakdown_region",
        "label": {
          "en": "Reverse breakdown"
        },
        "quantity": "i_r",
        "visual": {
          "treatment": "outline",
          "direction": "reverse"
        },
        "context": {
          "typical_display": "V(BR) ≥ 100 V at IR = 100 µA",
          "comparison": "the 75 V the part is rated to stand off continuously"
        },
        "teaching_point": {
          "en": "The rating and the breakdown are different numbers, and the gap between them is the manufacturer’s margin rather than yours."
        }
      }
    ],
    "panes": [
      "operating",
      "ideality"
    ],
    "interactions": [
      "probe",
      "substitute",
      "replace"
    ],
    "availability": {
      "en": "The through-hole 1N4148 every parts drawer has, and the reason this profile exists: Vishay publishes no SPICE model for it, so its DC parameters are fitted from the datasheet and say so. The SOD-123 1N4148W is the same die with a vendor model behind it."
    }
  },
