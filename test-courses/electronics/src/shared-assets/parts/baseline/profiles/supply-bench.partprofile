  "demonstration": {
    "reveals": [
      {
        "bind": "output_resistance",
        "label": {
          "en": "The resistor inside the supply",
          "fr": "La résistance cachée dans l’alimentation"
        },
        "enables_axis": "output_impedance",
        "quantity": "r_out",
        "transform": {
          "type": "materialise"
        },
        "visual": {
          "treatment": "outline"
        },
        "context": {
          "comparison": "the load resistance this supply is driving",
          "note": {
            "en": "Every source has one. A bench supply hides it behind a regulator; a battery wears it on its terminals.",
            "fr": "Toute source en a une. Une alimentation de laboratoire la cache derrière un régulateur ; une pile la porte à ses bornes."
          }
        },
        "teaching_point": {
          "en": "A supply is not a voltage — it is a voltage behind a resistance, and the schematic never draws the resistance. Fifty milliohms is nothing at ten milliamps and half a volt at ten amps.",
          "fr": "Une alimentation n’est pas une tension — c’est une tension derrière une résistance, et le schéma ne dessine jamais la résistance. Cinquante milliohms, ce n’est rien à dix milliampères, et c’est un demi-volt à dix ampères."
        }
      },
      {
        "bind": "output_drift",
        "label": {
          "en": "Output drift with temperature",
          "fr": "Dérive de la sortie avec la température"
        },
        "enables_axis": "tempco",
        "quantity": "v_oc",
        "visual": {
          "treatment": "none"
        },
        "teaching_point": {
          "en": "The rail a whole measurement is referenced to moves with the room. −50 ppm/°C is 0.5 mV on a 10 V rail across a lecture theatre warming up.",
          "fr": "Le rail auquel toute une mesure est référencée bouge avec la salle. −50 ppm/°C, c’est 0.5 mV sur un rail de 10 V dans un amphithéâtre qui se réchauffe."
        }
      }
    ],
    "panes": [
      "operating",
      "ideality"
    ],
    "interactions": [
      "probe",
      "substitute"
    ],
    "availability": {
      "en": "Any bench supply with a sense terminal behaves like this. A USB brick does not — its output impedance is an order of magnitude worse and its regulation is a different shape.",
      "fr": "Toute alimentation de laboratoire dotée d’une borne de mesure à distance (sense) se comporte ainsi. Un bloc d’alimentation USB, non — son impédance de sortie est pire d’un ordre de grandeur et sa régulation a une tout autre allure."
    }
  }
}
