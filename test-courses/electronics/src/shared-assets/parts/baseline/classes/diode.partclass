{
  "class": "diode",
  "label": "Diode",
  "designator": "D",
  "category": "semiconductors",
  "typical": {
    "source": {
      "document": "Vishay Semiconductors, document 81857 (1N4148)",
      "revision": "Rev. 1.6, 07-Nov-2024",
      "note": "Ptot = 440 mW, the class representative a small-signal glass diode (DO-35) is rated at. Absolute maximum only: a recommended figure is a profile's own choice of margin, and the class guessing one would print a rated power on a card that no datasheet gave."
    },
    "limits": {
      "absolute_max": {
        "p_w": 0.44
      },
      "recommended": {}
    }
  },
  "terminals": [
    {
      "id": "a",
      "label": "anode",
      "role": "anode",
      "signal": "bidirectional"
    },
    {
      "id": "k",
      "label": "cathode",
      "role": "cathode",
      "signal": "bidirectional"
    }
  ],
  "variants": {
    "signal": {
      "symbol": "symbols/iec/diode.svg",
      "label": "Signal diode"
    },
    "schottky": {
      "symbol": "symbols/iec/diode-schottky.svg",
      "label": "Schottky"
    },
    "zener": {
      "symbol": "symbols/iec/diode-zener.svg",
      "label": "Zener",
      "default_reveals": [
        "breakdown_region"
      ]
    },
    "led": {
      "symbol": "symbols/iec/led.svg",
      "label": "LED"
    }
  },
  "fast_model": {
    "equation": "shockley",
    "requires": [
      "is",
      "n"
    ],
    "optional": [
      "rs",
      "bv",
      "cjo",
      "tt",
      "alpha_vf",
      "r_th_ja_c_per_w"
    ],
    "outputs": [
      "i_f",
      "i_r",
      "v_f",
      "p"
    ]
  },
  "characteristic": {
    "x": "v_ak",
    "y": "i_a",
    "sweep": {
      "from": -60,
      "to": 1.2,
      "points": 400
    },
    "family": null,
    "default_scale": {
      "x": "linear",
      "y": "log"
    }
  },
  "ideality_axes": {
    "leakage": {
      "requires": [
        "is"
      ],
      "default": false,
      "label": "Reverse leakage"
    },
    "vf_tempco": {
      "requires": [
        "alpha_vf"
      ],
      "default": false,
      "label": "Forward voltage drift"
    },
    "junction_cap": {
      "requires": [
        "cjo"
      ],
      "default": false,
      "label": "Junction capacitance"
    },
    "recovery": {
      "requires": [
        "tt"
      ],
      "default": false,
      "label": "Reverse recovery"
    }
  },
  "capabilities": {
    "reveals": [
      "reverse_leakage",
      "reverse_recovery",
      "vf_temp_drift",
      "breakdown_region",
      "overcurrent"
    ],
    "panes": [
      "operating",
      "ideality"
    ],
    "interactions": [
      "probe",
      "substitute",
      "replace"
    ]
  }
}
