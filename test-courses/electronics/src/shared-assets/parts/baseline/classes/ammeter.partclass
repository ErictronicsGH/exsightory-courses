{
  "class": "ammeter",
  "label": {
    "en": "Ammeter",
    "fr": "Ampèremètre"
  },
  "designator": "A",
  "category": "measuring",
  "instrument": true,
  "measures": "current",
  "non_ideal_requires": [
    "r_burden_i_mode"
  ],
  "terminals": [
    {
      "id": "hi",
      "label": {
        "en": "input HI",
        "fr": "entrée HI"
      },
      "role": "input_high",
      "signal": "bidirectional"
    },
    {
      "id": "lo",
      "label": {
        "en": "input LO",
        "fr": "entrée LO"
      },
      "role": "input_low",
      "signal": "bidirectional"
    }
  ],
  "variants": {
    "bench": {
      "symbol": "symbols/iec/ammeter.svg",
      "label": {
        "en": "Bench ammeter",
        "fr": "Ampèremètre de laboratoire"
      }
    }
  },
  "fast_model": {
    "equation": "meter",
    "requires": [
      "r_burden_i_mode",
      "digits"
    ],
    "optional": [
      "accuracy_i_pct",
      "accuracy_i_counts"
    ],
    "outputs": [
      "reading",
      "v",
      "i"
    ]
  },
  "ideality_axes": {
    "burden": {
      "requires": [
        "r_burden_i_mode"
      ],
      "default": false,
      "label": {
        "en": "Burden voltage",
        "fr": "Chute de tension d’insertion"
      }
    }
  },
  "capabilities": {
    "adjust": {
      "parameter": "r_burden_i_mode",
      "legend": {
        "en": "Shunt resistance",
        "fr": "Résistance du shunt"
      },
      "from": 0.01,
      "to": {
        "parameter": "r_burden_max"
      },
      "stops": 20
    },
    "reveals": [
      "burden_voltage"
    ],
    "panes": [
      "operating",
      "measurement",
      "ideality"
    ],
    "interactions": [
      "substitute"
    ]
  }
}
