{
  "class": "dmm",
  "label": {
    "en": "Digital multimeter",
    "fr": "Multimètre numérique"
  },
  "designator": "M",
  "category": "measuring",
  "instrument": true,
  "measures": "voltage",
  "non_ideal_requires": [
    "r_in_v_mode",
    "r_burden_i_mode"
  ],
  "terminals": [
    {
      "id": "hi",
      "label": {
        "en": "input HI",
        "fr": "entrée HI"
      },
      "role": "input_high",
      "signal": "input"
    },
    {
      "id": "lo",
      "label": {
        "en": "input LO",
        "fr": "entrée LO"
      },
      "role": "input_low",
      "signal": "reference"
    }
  ],
  "variants": {
    "handheld": {
      "symbol": "symbols/iec/dmm.svg",
      "label": {
        "en": "Handheld",
        "fr": "Portatif"
      }
    },
    "bench": {
      "symbol": "symbols/iec/dmm-bench.svg",
      "label": {
        "en": "Bench",
        "fr": "De laboratoire"
      }
    }
  },
  "fast_model": {
    "equation": "meter",
    "requires": [
      "r_in_v_mode",
      "r_burden_i_mode",
      "digits"
    ],
    "optional": [
      "accuracy_v_pct",
      "accuracy_v_counts"
    ],
    "outputs": [
      "reading",
      "v",
      "i"
    ]
  },
  "ideality_axes": {
    "input_loading": {
      "requires": [
        "r_in_v_mode"
      ],
      "default": false,
      "label": {
        "en": "Input impedance loading",
        "fr": "Charge due à l’impédance d’entrée"
      }
    },
    "burden": {
      "requires": [
        "r_burden_i_mode"
      ],
      "default": false,
      "label": {
        "en": "Burden voltage",
        "fr": "Chute de tension d’insertion"
      }
    }
  },
  "capabilities": {
    "reveals": [
      "input_loading",
      "burden_voltage",
      "resolution_versus_accuracy"
    ],
    "panes": [
      "operating",
      "measurement",
      "ideality"
    ],
    "interactions": [
      "probe",
      "substitute"
    ]
  }
}
