  "failures": {
    "ovpTrip": {
      "group": "ovp",
      "trigger": {
        "quantity": "vOut",
        "op": ">",
        "value": "ovpLevel",
        "for_s": 0.001
      },
      "effect": {
        "set": {
          "output": "off"
        }
      },
      "signs": {
        "display": "OVP",
        "lamp": "lampOvp"
      },
      "latch": true,
      "reset": "lower the voltage, then press OUTPUT",
      "plantable": false,
      "say": {
        "en": "The output rose above the protection level, so the supply switched its output off.",
        "fr": "La sortie a dépassé le seuil de protection : l’alimentation a coupé sa sortie."
      }
    },
    "thermalShutdown": {
      "trigger": {
        "quantity": "pPass",
        "op": ">",
        "value": 100,
        "unit": "W",
        "for_s": 60
      },
      "effect": {
        "set": {
          "output": "off"
        }
      },
      "signs": {
        "display": "OTP",
        "sound": "fan-high"
      },
      "latch": true,
      "reset": "switch off, let it cool for 30 s",
      "plantable": false,
      "design": "values to confirm",
      "say": {
        "en": "The pass transistor got too hot: it burns (V_in − V_out) × I as heat, 105 W at 15 V out from the 36 V rail at 5 A.",
        "fr": "Le transistor ballast a trop chauffé : il dissipe (V_in − V_out) × I, soit 105 W à 15 V en sortie sur le rail de 36 V à 5 A."
      }
    },
    "mainsFuse": {
      "trigger": {
        "event": "internal-fault"
      },
      "effect": {
        "set": {
          "power": "off"
        },
        "damage": "open"
      },
      "signs": {
        "variant": "fuseBlown",
        "display": "blank"
      },
      "latch": true,
      "reset": "replace the 2 A T fuse",
      "plantable": true,
      "say": {
        "en": "Nothing lights: the mains fuse has blown.",
        "fr": "Rien ne s’allume : le fusible secteur a fondu."
      }
    },
    "loosePost": {
      "trigger": {
        "event": "armed"
      },
      "effect": {
