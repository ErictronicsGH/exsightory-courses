        "damage": "degraded",
        "rContact": 2.0
      },
      "signs": {},
      "latch": true,
      "reset": "tighten the post",
      "plantable": true,
      "say": {
        "en": "The red post was loose: 2 Ω in series drops the voltage under load.",
        "fr": "La borne rouge était desserrée : 2 Ω en série font chuter la tension en charge."
      }
