  "behaviour": {
    "model": "dc-supply.switching@1",
    "parameters": {
      "cOut": {
        "value": 0.00094,
        "unit": "F",
        "names": {
          "en": "Output capacitance",
          "fr": "Capacité de sortie"
        },
        "why": "two 470 µF output capacitors; design value, to confirm"
      },
      "rBleed": {
        "value": 2200,
        "unit": "Ω",
        "names": {
          "en": "Bleed resistor",
          "fr": "Résistance de décharge"
        }
      },
      "tSoftStart": {
        "value": 0.05,
        "unit": "s"
      },
      "tSelfTest": {
        "value": 1.0,
        "unit": "s"
      },
      "tFade": {
        "value": 0.3,
        "unit": "s"
      },
      "rippleCV": {
        "value": 0.03,
        "unit": "V",
        "basis": "pp",
        "why": "≤ 30 mV peak to peak, typical of this class"
      },
      "rippleCC": {
        "value": 0.02,
        "unit": "A",
        "basis": "pp"
      },
      "loadRegulation": {
        "pct": 0.1,
        "plus": 0.01,
        "unit": "V"
      },
      "efficiency": {
        "value": 0.88,
        "unit": "",
        "why": "at full load; design value, to confirm"
      },
      "pIdle": {
        "value": 2,
        "unit": "W",
        "why": "the converter, the displays and the fan with no load"
      },
      "rTh": {
        "value": 1.8,
        "unit": "K/W",
        "why": "inside to room with the fan running; design value, to confirm"
      },
      "tAmb": {
        "value": 25,
        "unit": "°C"
      },
      "tThermal": {
        "value": 120,
        "unit": "s",
        "why": "the inside's thermal time constant; design value, to confirm"
      },
      "tResetBelow": {
        "value": 60,
        "unit": "°C",
        "why": "after an over-temperature trip, the output may come back once the inside is below this"
      },
      "refreshHz": {
        "value": 4,
        "unit": "Hz"
      }
    }
  },
